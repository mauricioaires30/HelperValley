{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelperValley",
  "version": "0.1.2",
  "identifier": "io.github.mauricioaires30.helpervalley",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HelperValley",
        "width": 440,
        "height": 600,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Copies your Stardew Valley saves for the HelperValley website",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQTc3NUUzMjYzRDVBNUMKUldSY1dqMG00M1dubXpsL3pOREZ4T0Z4cUdaU3pSVGdtRVl4SEVwVmlDeXM2L0VTSjJVRUJiVVUK",
      "endpoints": ["https://github.com/mauricioaires30/HelperValley/releases/latest/download/latest.json"]
    }
  }
}
