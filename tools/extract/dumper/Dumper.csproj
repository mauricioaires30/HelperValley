<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dumps Stardew Valley data assets (Data/*, Strings/*, schedules...) to JSON by loading them
    with the game's own MonoGame ContentManager and GameData types.
    Usage: see tools/extract/README.md
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MonoGame.Framework"><HintPath>$(GameDir)\MonoGame.Framework.dll</HintPath></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>$(GameDir)\StardewValley.GameData.dll</HintPath></Reference>
  </ItemGroup>
</Project>
