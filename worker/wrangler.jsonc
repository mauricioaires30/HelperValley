{
  // HelperValley's multiplayer relay. Deployed by .github/workflows/worker.yml.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpervalley-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://mauricioaires30.github.io"
  },
  "observability": { "enabled": true }
}
